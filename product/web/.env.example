# Copy to `.env.local`. Never commit real credentials.
# Server-only. Do not prefix with NEXT_PUBLIC_.

# Neon Postgres. Local `pnpm dev` and Vercel production both query this URL
# from the Next.js server (NeonScoreRepository). Pooled URLs are fine for the
# HTTP serverless driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Helmcode (OpenAI-compatible, EU). Server-only. Used by POST /api/chat,
# /api/ask, /api/ask/followups, /api/ask/warmup and /api/watcher/reply.
# Never prefix with NEXT_PUBLIC_.
# Docs: https://helmcode.com/es/docs
HELMCODE_API_KEY=
# HELMCODE_BASE_URL=https://api.helmcode.com/v1
# POC_LLM_MODEL=deepseek-v4-flash
# HELMCODE_TEMPERATURE=0.2

# Exa (server-only). Pregunta thinking mode only: one web search after product tools.
# Never prefix with NEXT_PUBLIC_. https://dashboard.exa.ai/api-keys
# EXA_API_KEY=
