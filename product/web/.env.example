# Copy to `.env.local`. Never commit real credentials.
# Server-only. Do not prefix with NEXT_PUBLIC_.

# Neon Postgres. Local `pnpm dev` and Vercel production both query this URL
# from the Next.js server (NeonScoreRepository). Pooled URLs are fine for the
# HTTP serverless driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Health Score dumb chat (POST /api/chat) uses Vercel AI Gateway via OIDC.
# On Vercel this is automatic. Locally: `vercel env pull .env.local --yes`
# (writes VERCEL_OIDC_TOKEN, ~24h). No AI_GATEWAY_API_KEY needed on the linked project.

# Helmcode (OpenAI-compatible). Server-only. Required for POST /api/ask and
# POST /api/watcher/reply. Never prefix with NEXT_PUBLIC_.
HELMCODE_API_KEY=
# HELMCODE_BASE_URL=https://api.helmcode.com/v1
# POC_LLM_MODEL=deepseek-v4-flash
