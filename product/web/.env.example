# Copy to `.env.local`. Never commit real credentials.
# Server-only. Do not prefix with NEXT_PUBLIC_.

# Neon Postgres. Local `pnpm dev` and Vercel production both query this URL
# from the Next.js server (NeonScoreRepository). Pooled URLs are fine for the
# HTTP serverless driver.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
